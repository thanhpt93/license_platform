# NOVA License Management System — Environment Configuration Example
# Copy this file to .env and customize for your deployment environment.
# NEVER commit .env or private signing keys to version control.

# Database connection string
# Development (SQLite):
NOVA_DATABASE_URL=sqlite:///./nova_license.db
# Production (PostgreSQL example):
# NOVA_DATABASE_URL=postgresql+psycopg://nova_admin:CHANGE_ME@localhost:5432/nova_license_db

# JWT Authentication Secret (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
NOVA_JWT_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_BYTES
NOVA_JWT_ALGORITHM=HS256
NOVA_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Active Ed25519 Signing Key Configuration
# Key ID of the currently active signing key (must match a registered SigningKey record)
NOVA_ACTIVE_KEY_ID=nova-key-2026-01

# Path to the Ed25519 private key PEM file (kept strictly on the license server)
NOVA_SIGNING_PRIVATE_KEY_PATH=./keys/nova_ed25519_private.pem

# Optional: Passphrase if the private key PEM is encrypted
NOVA_SIGNING_KEY_PASSPHRASE=

# Initial Bootstrap Super Administrator (Used only by scripts/bootstrap_dev.py or initial admin creation CLI)
# Never hardcode production credentials in source code.
NOVA_BOOTSTRAP_ADMIN_USERNAME=admin
NOVA_BOOTSTRAP_ADMIN_EMAIL=admin@nova-vision.local
NOVA_BOOTSTRAP_ADMIN_PASSWORD=

# CORS Allowed Origins (comma-separated)
NOVA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
